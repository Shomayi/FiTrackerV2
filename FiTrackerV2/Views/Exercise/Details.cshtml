@using FiTrackerV2.Domain.Models
@model Exercise

@{
    ViewData["Title"] = "Exercise Details";
}

<h1>Exercise Details</h1>

<div class="mb-2">
    <strong>Name:</strong> @Model.Name
</div>
<div class="mb-2">
    <strong>Sets:</strong> @Model.Sets
</div>
<div class="mb-2">
    <strong>Reps:</strong> @Model.Reps
</div>
<div class="mb-2">
    <strong>Weight:</strong> @Model.Weight
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
