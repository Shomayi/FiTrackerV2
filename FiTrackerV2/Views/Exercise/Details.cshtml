@using FiTrackerV2.Domain.Models
@model Exercise

@{
    ViewData["Title"] = "Exercise Details";
}

<h1>Exercise Details</h1>

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" disabled />
</div>

<div class="mb-3">
    <label asp-for="Sets" class="form-label"></label>
    <input asp-for="Sets" type="number" class="form-control" disabled />
</div>

<div class="mb-3">
    <label asp-for="Reps" class="form-label"></label>
    <input asp-for="Reps" type="number" class="form-control" disabled />
</div>

<div class="mb-3">
    <label asp-for="Weight" class="form-label"></label>
    <input asp-for="Weight" type="number" class="form-control" step="0.1" disabled />
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>

<form asp-action="Delete" method="post" asp-route-id="@Model.Id" class="d-inline">
    <button type="submit" class="btn btn-danger"
            onclick="return confirm('Are you sure you want to delete this exercise?');">
        Delete
    </button>
</form>

<a asp-action="Index" class="btn btn-secondary">Back</a>