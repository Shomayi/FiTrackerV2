@using FiTrackerV2.Domain.Models
@model IEnumerable<Exercise>

@{
    ViewData["Title"] = "Exercises";
}

<h1>Exercises</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Exercise</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Sets</th>
            <th>Reps</th>
            <th>Weight</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var exercise in Model)
        {
            <tr>
                <td>@exercise.Name</td>
                <td>@exercise.Sets</td>
                <td>@exercise.Reps</td>
                <td>@exercise.Weight</td>
                <td>
                    <a asp-action="Details" asp-route-id="@exercise.Id" class="btn btn-info btn-sm">View</a>
                    <a asp-action="Edit" asp-route-id="@exercise.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@exercise.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
